# Where product, collection and cart data comes from.
#   live      Shopify Storefront API (defaults to Shopify's public mock.shop sandbox)
#   fixtures  Bundled sample data, no network needed (used by tests and CI)
SHOPIFY_DATA_SOURCE=live

# Storefront API endpoint. Leave empty to use https://mock.shop/api.
# For a real store: https://<your-store>.myshopify.com/api/2025-07/graphql.json
SHOPIFY_STOREFRONT_ENDPOINT=

# Public Storefront API access token. Not needed for mock.shop.
SHOPIFY_STOREFRONT_TOKEN=

# Absolute site URL, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (G-XXXXXXX). Optional. Analytics only load after consent.
NEXT_PUBLIC_GA_ID=

# Where "Designed and built by" in the footer links to. Defaults to the author's GitHub profile.
NEXT_PUBLIC_AUTHOR_URL=
